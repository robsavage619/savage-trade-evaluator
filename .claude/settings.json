{
  "permissions": {
    "allow": [
      "Bash(uv run ste:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(uv run python -m savage_trade_evaluator:*)"
    ],
    "deny": [
      "Bash(rm -rf data/duckdb:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard origin/*:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "command -v uv >/dev/null || exit 0; uv run --no-sync ruff check --no-cache . 1>&2 || exit 2" }
        ]
      }
    ]
  }
}
